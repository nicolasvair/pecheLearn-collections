          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Le père entend une voix, mais ne voit pas son fils."
            },
            "numero": {
              "text": "Phrase 11"
            },
            "sr": {
              "text": "Otac čuje glas, ali ne vidi sina."
            },
            "sr_cyrillique": {
              "text": "Отац чује глас, али не види сина."
