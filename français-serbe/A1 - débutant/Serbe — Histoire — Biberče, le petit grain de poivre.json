          "id": "srpski.biberce.phrase.9d14e2c4dc72",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Biberče crie depuis le ventre du bœuf."
            },
            "numero": {
              "text": "Phrase 10"
            },
            "sr": {
              "text": "Biberče viče iz stomaka vola."
            },
            "sr_cyrillique": {
              "text": "Биберче виче из стомака вола."
            },
            "vocab": {
              "text": "vikati — crier\nstomak — ventre"
