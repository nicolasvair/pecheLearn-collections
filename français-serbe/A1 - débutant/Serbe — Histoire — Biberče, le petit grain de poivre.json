      "notes": [
        {
          "fields": {
            "fr": {
              "text": "Il était une fois une femme."
            },
            "numero": {
              "text": "Phrase 1"
            },
            "sr": {
              "text": "Bila jednom jedna žena."
            },
            "sr_cyrillique": {
              "text": "Била једном једна жена."
            },
            "vocab": {
              "text": "žena — femme"
            }
          },
          "id": "srpski.biberce.phrase.714f44474d58",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "La femme n'a pas d'enfants."
            },
            "numero": {
              "text": "Phrase 2"
            },
            "sr": {
              "text": "Žena nema dece."
            },
            "sr_cyrillique": {
              "text": "Жена нема деце."
            },
            "vocab": {
              "text": "nemati — ne pas avoir\ndete / deca — enfant / enfants"
            }
          },
          "id": "srpski.biberce.phrase.832bc3d6a4e1",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "La femme dit : « Je veux un enfant, même petit comme un grain de poivre ! »"
            },
            "numero": {
              "text": "Phrase 3"
            },
            "sr": {
              "text": "Žena kaže: \"Hoću dete, makar bilo malo kao zrno bibera!\""
            },
            "sr_cyrillique": {
              "text": "Жена каже: \"Хоћу дете, макар било мало као зрно бибера!\""
            },
            "vocab": {
              "text": "hteti (hoću) — vouloir (je veux)\nzrno bibera — grain de poivre"
            }
          },
          "id": "srpski.biberce.phrase.8ae41ae89e20",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Bientôt, la femme a un fils."
            },
            "numero": {
              "text": "Phrase 4"
            },
            "sr": {
              "text": "Uskoro žena dobija sina."
            },
            "sr_cyrillique": {
              "text": "Ускоро жена добија сина."
            },
            "vocab": {
              "text": "uskoro — bientôt\nsin — fils"
            }
          },
          "id": "srpski.biberce.phrase.d91292643e41",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Le fils est petit comme un grain de poivre."
            },
            "numero": {
              "text": "Phrase 5"
            },
            "sr": {
              "text": "Sin je mali kao zrno bibera."
            },
            "sr_cyrillique": {
              "text": "Син је мали као зрно бибера."
            },
            "vocab": {
              "text": "mali — petit"
            }
          },
          "id": "srpski.biberce.phrase.3286eadb25eb",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "La femme l'appelle Biberče."
            },
            "numero": {
              "text": "Phrase 6"
            },
            "sr": {
              "text": "Žena ga zove Biberče."
            },
            "sr_cyrillique": {
              "text": "Жена га зове Биберче."
            },
            "vocab": {
              "text": "zvati — appeler"
            }
          },
          "id": "srpski.biberce.phrase.2c7b46e3c812",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Biberče est un garçon intelligent et courageux."
            },
            "numero": {
              "text": "Phrase 7"
            },
            "sr": {
              "text": "Biberče je pametan i hrabar dečak."
            },
            "sr_cyrillique": {
              "text": "Биберче је паметан и храбар дечак."
            },
            "vocab": {
              "text": "pametan — intelligent\nhrabar — courageux\ndečak — garçon"
            }
          },
          "id": "srpski.biberce.phrase.ed2bc62f99ff",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Un jour, Biberče va au champ avec son père."
            },
            "numero": {
              "text": "Phrase 8"
            },
            "sr": {
              "text": "Jednog dana, Biberče ide u polje sa ocem."
            },
            "sr_cyrillique": {
              "text": "Једног дана, Биберче иде у поље са оцем."
            },
            "vocab": {
              "text": "polje — champ\notac — père"
            }
          },
          "id": "srpski.biberce.phrase.8a9a5b9bd9c4",
          "modelID": "srpski.biberce.model.phrase",
          "tags": [
            "histoire",
            "biberce",
            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "Un grand bœuf avale Biberče."
            },
            "numero": {
              "text": "Phrase 9"
            },
            "sr": {
              "text": "Veliki vo proguta Biberčeta."
