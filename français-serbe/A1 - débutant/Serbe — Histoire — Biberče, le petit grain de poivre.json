            "phrase"
          ]
        },
        {
          "fields": {
            "fr": {
              "text": "À la fin, la mère retrouve Biberče et il sort entier et vivant."
            },
            "numero": {
              "text": "Phrase 12"
            },
            "sr": {
              "text": "Na kraju, majka pronalazi Biberčeta i on izlazi ceo i živ."
            },
            "sr_cyrillique": {
              "text": "На крају, мајка проналази Биберчета и он излази цео и жив."
